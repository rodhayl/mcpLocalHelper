# MCP Local LLM Server - OpenCode CLI Optimized Settings
# This file enables PURE CLI MODE for maximum throughput with OpenCode CLI.
# Zero local LLM overhead - all processing done by OpenCode's external model.

# ============================================
# CENTRAL CONFIG (JSON)
# ============================================
# Optimized for pure OpenCode CLI execution with kimi-k2.5-free model.

[config]
CONFIG_JSON={"backends":[{"id":"ollama","type":"ollama","base_url":"http://127.0.0.1:11434","labels":{"priority":"secondary"}},{"id":"lmstudio","type":"lmstudio","base_url":"http://127.0.0.1:1234","labels":{"priority":"tertiary"}},{"id":"opencode-cli","type":"opencode","command":"opencode","args_template":["run","--format","json","--model","opencode/big-pickle","{prompt}"],"timeout":300000,"auto_approve":true}],"defaults":{"localBackendId":"ollama","localModel":""},"mcpServers":{},"workspace":{"roots":[".."],"defaultRoot":".."},"policy":{"allowlistPaths":["..","."],"maxFileBytes":131072},"systemProfile":{"exposeToLLM":false},"features":{"testingModeEnabled":true},"server":{"port":3000,"host":"127.0.0.1","maxConcurrentAgentTasks":4,"maxConcurrentClients":6,"agentTaskQueueTimeoutMs":180000},"toolGroups":{"activeMode":"DEVELOPMENT"},"readEnhancements":{"maxBatchFiles":50,"maxBatchBytes":262144,"maxLineSpan":2000,"enableIndexing":true,"indexingLanguages":["ts","js","py","md"],"maxConcurrentReads":8},"privacy":{"riskScoreThreshold":0.75,"secretPatterns":"default"},"editing":{"enabled":true,"backupEnabled":true,"backupDir":".mcp-backups","requirePreview":false,"maxFileSize":1048576},"toolDiscovery":{"fullToolList":false},"toolOrchestration":{"globalSettings":{"defaultOrchestrationEnabled":true,"defaultPreferredBackend":"opencode","defaultFallbackToLocal":false,"defaultQuickMode":true,"pureCliMode":true,"probeOnStartup":true,"skipLocalLlmInit":true,"enableBatchExecution":true}}}

# ============================================
# PRODUCTION SETTINGS
# ============================================
# Local LLM is NOT used in pure CLI mode.

[production]
LOCAL_BACKEND_ID=ollama
LOCAL_MODEL=
LOCAL_BACKEND_URL=http://127.0.0.1:11434

# ============================================
# TESTING SETTINGS
# ============================================

[testing]
TESTING_MODE_ENABLED=true
TEST_LOCAL_BACKEND_ID=ollama
TEST_LOCAL_MODEL=
TEST_LOCAL_BACKEND_URL=http://127.0.0.1:11434
TEST_SOTA_BACKEND_TYPE=local
TEST_SOTA_BACKEND_ID=
TEST_SOTA_MODEL=
TEST_SOTA_BACKEND_URL=
OPENROUTER_API_KEY=

# ============================================
# ADVANCED SETTINGS
# ============================================

[advanced]
SERVER_PORT=3000
SERVER_HOST=127.0.0.1
EXPOSE_SYSTEM_PROFILE=false
TOOL_GROUP_MODE=DEVELOPMENT
EMBEDDING_MODEL=
EMBEDDING_BACKEND_URL=
AGENT_MAX_STEPS=50
AGENT_MAX_ACTIONS_PER_STEP=100
AGENT_MAX_SUBTASKS=8
AGENT_TIMEOUT_MS=300000

# ============================================
# CLI ORCHESTRATION SETTINGS
# ============================================
# PURE CLI MODE: Maximum throughput with OpenCode CLI

[CLI_ORCHESTRATION]
CLI_ORCHESTRATION_ENABLED=true
CLI_ORCHESTRATION_BACKENDS=opencode-cli
CLI_AUTO_VERIFY=false
CLI_SCORE_THRESHOLD=7
CLI_MAX_ITERATIONS=1
CLI_PURE_MODE=true
