# MCP Local LLM Server - Environment Settings (Example)
# ============================================
# Copy this file to env.settings and customize as needed.
#
# Usage:
#   mcp-local-llm --settings /path/to/env.settings
#   or
#   node node_modules/mcp-local-llm/dist/index.js --settings /path/to/env.settings
# ============================================

# ============================================
# [config] SECTION - REQUIRED
# ============================================
# The [config] section with CONFIG_JSON is REQUIRED for the server to start.
# During installation, this section is automatically created or patched.
# If you manually edit this file, do NOT remove the [config] section.
# ============================================

[config]
CONFIG_JSON={"backends":[{"id":"lmstudio","type":"lmstudio","base_url":"http://127.0.0.1:1234","labels":{"priority":"primary"}},{"id":"ollama","type":"ollama","base_url":"http://127.0.0.1:11434","labels":{"priority":"secondary"}}],"defaults":{"localBackendId":"lmstudio"},"workspace":{"roots":[".."],"defaultRoot":".."},"policy":{"allowlistPaths":["..","."],"maxFileBytes":131072},"systemProfile":{"exposeToLLM":false},"server":{"port":3000,"host":"127.0.0.1"},"toolGroups":{"activeMode":"DEVELOPMENT"},"privacy":{"riskScoreThreshold":0.75,"secretPatterns":"default"}}

[production]
LOCAL_BACKEND_ID=lmstudio
LOCAL_MODEL=
LOCAL_BACKEND_URL=http://127.0.0.1:11434

[testing]
TESTING_MODE_ENABLED=false
TEST_LOCAL_BACKEND_ID=lmstudio
TEST_LOCAL_MODEL=
TEST_LOCAL_BACKEND_URL=http://127.0.0.1:11434
TEST_SOTA_BACKEND_TYPE=local
TEST_SOTA_BACKEND_ID=
TEST_SOTA_MODEL=
TEST_SOTA_BACKEND_URL=
OPENROUTER_API_KEY=

[advanced]
SERVER_PORT=3000
SERVER_HOST=127.0.0.1
EXPOSE_SYSTEM_PROFILE=false
TOOL_GROUP_MODE=DEVELOPMENT
AGENT_MAX_STEPS=50
AGENT_MAX_ACTIONS_PER_STEP=100
AGENT_MAX_SUBTASKS=8
AGENT_TIMEOUT_MS=300000

[CLI_ORCHESTRATION]
CLI_ORCHESTRATION_ENABLED=true
CLI_ORCHESTRATION_BACKENDS=opencode-cli
CLI_AUTO_VERIFY=true
CLI_SCORE_THRESHOLD=7
CLI_MAX_ITERATIONS=3

